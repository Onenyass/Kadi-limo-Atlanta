# Copy to .env.local for local development, or add these in the Netlify
# dashboard (Site configuration -> Environment variables). Never commit real values.

# Public URL of this deployment, used for canonical links, Open Graph and sitemap.
# Example: the Netlify preview URL. Do NOT set to kadilimoatl.com until the owner approves launch.
NEXT_PUBLIC_SITE_URL=

# Set to "true" only at public launch. While false, pages are marked noindex
# and robots.txt blocks crawlers so the preview never competes with the live domain.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Ride-request form mode:
#   preview  -> form validates and produces a copyable request summary; nothing is sent.
#   netlify  -> form submits to Netlify Forms. Use only after the form is verified on Netlify.
NEXT_PUBLIC_FORM_MODE=preview

# Sanity CMS. Leave empty to use the built-in seed content in src/content/seed.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-19
# Optional: only needed if the dataset is private. Create a read-only "Viewer" token.
SANITY_API_READ_TOKEN=
